#!/usr/bin/env bash
# Pre-push hook: run eye_test_engine unit tests before allowing git push.
# Install once: git config core.hooksPath .githooks

set -e

cd "$(git rev-parse --show-toplevel)"

echo "Running eye_test_engine unit tests..."
if ! python -m unittest discover -s eye_test_engine/tests -p "test_*.py" -v; then
  echo ""
  echo "Unit tests failed. Push aborted."
  exit 1
fi

echo ""
echo "All tests passed. Pushing..."
exit 0
